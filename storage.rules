rules_version = '2';

// Lifestyle photos and videos (stored under posts/):
//  - anyone signed in can view
//  - only the owner account can upload or delete, images/videos under 500 MB
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "owner@wenzuoweb.firebaseapp.com";
    }

    match /posts/{fileName} {
      allow read: if request.auth != null;
      allow delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
